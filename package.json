{
  "name": "net-recorder-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome 扩展：在指定网站自动记录所有网络请求（React + antd + Vite）",
  "scripts": {
    "dev": "npm run build && concurrently -k -n popup,ext -c cyan,magenta \"vite build --watch\" \"node scripts/build-extension.mjs --watch\"",
    "build": "rm -rf dist && vite build && node scripts/build-extension.mjs",
    "build:popup": "vite build",
    "build:ext": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "check": "esbuild scripts/check.ts --bundle --platform=node --format=esm --outfile=.check/check.mjs --log-level=warning && node .check/check.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
